// Functions, header and body: `P3-11` laid out the body and `P3-11a` the
// header, and the two only meet in a whole file. Spacing here is
// deliberately wrong everywhere it can be, so that a rule which stopped
// running shows up as text rather than as a passing test.

package fn_pkg {

    // Declarations: a function with no body is not a block, so these reach a
    // different builder from the definitions below.
    function void  poke ( bit[32]  addr , bit[32] data ) ;
    function int   sample ( ) ;

    import  target  C  function  void  drive ( bit[8] v ) ;
    import target function read;

    pure  function bit[32] mask (  int  n ) ;

    // Declined: a comment inside a prototype. `emit_span` refuses any span
    // holding one, so this line is the author's, byte for byte.
    function void  print ( string  fmt /*, type ... args*/ ) ;
}

component fn_c {

    bit[64]  base_addr;

    function  bit[32]   ch_addr( int   ch )
    {
        // A brace the author put on its own line, and a body indented to a
        // column of its own.
        int  off = ch * 4;
           return base_addr + off;
    }

    // Declined header, formatted body: a hand-built parameter table joins to
    // 90-odd columns and there is no parameter-list break policy, so the
    // header is reproduced -- while everything inside the braces is not.
    target function void check(
        addr_handle_t  base,
        bit[32]        nbytes,
        bit[32]        seed) {
 int   nwords = nbytes / 4;
        bit[32]  expected;
        bit[32]  actual;
    }

    function void empty( ) { }

    function int demo(array<int,8> a, int n) { return n; }

    // Statements: `P3-11b`. Everything here was reproduced verbatim until
    // `procedural_stmt` reached the registry.
    function void statements(int n) {
        int   x  =  1 ;
        x  +=  2 ;
        x   =   - n ;
        regs . ch [ n ] . write ( x , 3 ) ;
        return ;
    }

    // A hand-built table of assignments, which the `=` column stop keeps.
    // 22 of the corpus's 93 assignments are padded like this, across 8 files.
    function void configure(cfg_s cfg) {
        ctrl.en        = 1;
        ctrl.start     = 0;
        ctrl.lsb_first = cfg.lsb_first;
        regs.ctrl.write(ctrl);
    }

    // `match`: a block, and the construct that was hiding 195 of the corpus's
    // 201 return statements behind it.
    function bit[64] offset_of(string name) {
        match ( name ) {
            [ "ctrl" ]:   return 0x0;
            ["status"]: return 0x8;

            // A choice whose statement is a block rather than a statement --
            // four of the corpus's 199, and they hold 12 statements nothing
            // could reach before.
            [ "wide" ]: {
                x = 1;
                return 0x10;
            }
            default:    return -1;
        }
    }

    // `break` and `continue` are reached by no corpus file: the corpus has
    // one of each and both sit inside an `if`, which `P3-11b` declines.
    function void loops() {
        match (n) {
            [0]: break;
            [1]: continue;
            default: yield;
        }
    }

    // Declined, and each for its own reason. `if`/`else` needs the `} else {`
    // rule `docs/style.rst` does not state; `repeat … while` puts its block in
    // the *middle* of the statement, which the block layout cannot express.
    function void declined(int n) {
        if (n > 0)  { n  -=  1; } else { n  +=  1; }
        repeat { n += 1; } while (n < 4);
        message(NONE, "a call the author wrapped, which joins past the width",
                n, n, n);
    }
}
